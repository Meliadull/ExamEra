# Порт API-сервера (в production также учитывается PORT)
API_PORT=4000

# Путь к файлу базы данных SQLite (по умолчанию server/data/examera.db)
# DB_PATH=./data/examera.db

# OAuth Client ID из Google Cloud Console (Credentials → OAuth 2.0 Client IDs, тип "Web application").
# Пока не задан, кнопка «Войти через Google» будет неактивна.
GOOGLE_CLIENT_ID=

# SMS-провайдер для OTP. "console" — код печатается в консоль сервера и показывается в интерфейсе (только для разработки!)
SMS_PROVIDER=console

# Выставьте true, если приложение работает за HTTPS (cookie будут помечены Secure)
COOKIE_SECURE=false

# Выставьте true, если сервер стоит за reverse proxy (nginx и т.п.) — для корректного IP в журнале аудита
TRUST_PROXY=false

# Заполнять пустую БД демонстрационными данными при первом запуске
SEED_DEMO=true

# Резервные копии базы (ежедневно): папка и сколько автоматических копий хранить
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
